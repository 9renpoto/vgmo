---
import ConcertSearchPage from "../components/ConcertSearchPage";
import MainLayout from "../layouts/MainLayout.astro";
import { listConcerts } from "../utils/concerts";

const concerts = await listConcerts({ includePast: true });
---

<MainLayout title="vgmo | ゲーム音楽オーケストラまとめ" showHeader={false}>
  <ConcertSearchPage client:load allConcerts={concerts} />
</MainLayout>
